// -----------------------------------------------------------------------------
// Database-backed job queue. Works without Redis or a permanent worker:
// a scheduled command (Hostinger cron / system cron / external scheduler) runs
// `npm run jobs:tick`, which claims due jobs with
// SELECT ... FOR UPDATE SKIP LOCKED, runs them within a time budget, and exits.
// On a VPS the same code can run as a long-lived worker.
// -----------------------------------------------------------------------------

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// Exhausted retries; needs attention.
  DEAD
}

model Job {
  id          String    @id @default(uuid(7))
  /// e.g. "scan.listing", "stats.rollup", "domain.recheck", "email.send"
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  priority    Int       @default(0)
  runAt       DateTime  @default(now()) @db.DateTime(3)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime? @db.DateTime(3)
  lockedBy    String?
  lastError   String?   @db.Text
  /// Prevents duplicate enqueues (e.g. "scan.listing:<id>:<window>").
  dedupeKey   String?   @unique
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  /// When the last attempt started, how long it took and what it reported (Admin → Scheduler).
  startedAt   DateTime? @db.DateTime(3)
  durationMs  Int?
  result      Json?

  @@index([status, runAt, priority])
  @@index([type, status])
}

/// One row per scheduler invocation, for operational visibility.
model JobRun {
  id         String    @id @default(uuid(7))
  runner     String
  startedAt  DateTime  @default(now()) @db.DateTime(3)
  finishedAt DateTime? @db.DateTime(3)
  processed  Int       @default(0)
  failed     Int       @default(0)
  error      String?   @db.Text
  /// "cron" (Hostinger scheduled task), "admin" (Run now) or "cli".
  trigger    String    @default("cron") @db.VarChar(20)
  enqueued   Int       @default(0)
  recovered  Int       @default(0)
  /// Another run held the scheduler lock, so this one did nothing.
  skipped    Boolean   @default(false)

  @@index([startedAt])
}
