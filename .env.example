# Copy to .env and fill in locally. Never commit .env.
# Values below are placeholders only.

# --- Database (PostgreSQL 15+) ---
DATABASE_URL="postgresql://webcenter:CHANGE_ME@localhost:5432/webcenter_dev?schema=public"

# --- Domains (no trailing slash) ---
PUBLIC_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://admin.localhost:3000"
DEVELOPER_ORIGIN="http://developers.localhost:3000"

# --- Secrets (generate with: openssl rand -base64 32) ---
USER_AUTH_SECRET=""
ADMIN_AUTH_SECRET=""
# Used to HMAC visitor identifiers for privacy-conscious unique counts
ANALYTICS_SALT_SECRET=""
# Shared secret for scheduled-job HTTP endpoint (if cron uses HTTP instead of CLI)
CRON_SECRET=""
# AES-256-GCM key for encrypting stored secrets such as admin TOTP seeds
FIELD_ENCRYPTION_KEY=""

# --- OAuth (Phase 2; leave empty to disable a provider) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# --- Email (Phase 2) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="WebCenter <no-reply@webcenter.com>"

# --- File storage: "local" or "s3" (S3-compatible: R2, B2, S3, Spaces) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# --- Security scanning providers (Phase 6; check licence terms before use) ---
GOOGLE_WEB_RISK_API_KEY=""
URLHAUS_AUTH_KEY=""
VIRUSTOTAL_API_KEY=""

# --- Error monitoring (optional) ---
SENTRY_DSN=""
