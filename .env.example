# Copy to .env for local development. NEVER commit .env or real credentials.
# Production values are set in Hostinger hPanel → Websites → Node.js → Environment
# variables (see docs/DEPLOYMENT.md).
#
# ============================================================================
# 1) REQUIRED AT STARTUP — the only values the server needs before it can reach
#    the database. Everything else is configured in Admin → Settings.
# ============================================================================

NODE_ENV=development

# MySQL / MariaDB. Hostinger: hPanel → Databases → MySQL Databases. Use host 127.0.0.1
# (NOT "localhost": Node.js resolves that to IPv6 ::1, which the database user is not
# granted) and port 3306. URL-encode special characters in the password
# (@ → %40, : → %3A, / → %2F).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/DB_NAME"

# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts credentials saved in Admin → Settings and admin two-factor secrets, and
# derives the user session secret. KEEP A COPY: if it is lost or changed, saved
# credentials must be re-entered, every user is signed out and admins must re-enrol 2FA.
FIELD_ENCRYPTION_KEY=""

# Public address, no trailing slash. The admin portal defaults to admin.<host> and
# the developer address to developers.<host>.
PUBLIC_ORIGIN="http://localhost:3000"

# ============================================================================
# 2) FIRST-TIME SETUP ONLY — opens https://admin.<host>/setup while no Super
#    Administrator exists. At least 32 characters (openssl rand -hex 32).
#    Accepting the owner invitation locks /setup permanently; then remove it.
#    Full Hostinger checklist: docs/HOSTINGER-ENV.md
# ============================================================================
SETUP_TOKEN=""

# ============================================================================
# 3) OPTIONAL hosting/infrastructure values
# ============================================================================

# Only if the admin/developer hosts are not admin.<public host> / developers.<public host>.
ADMIN_ORIGIN=""
DEVELOPER_ORIGIN=""
# Session-signing secret for user accounts. Empty = derived from FIELD_ENCRYPTION_KEY.
USER_AUTH_SECRET=""
# A different URL for the Prisma CLI (e.g. Hostinger's remote MySQL host from your computer).
DIRECT_URL=""
# disable | require | verify-full (default: disable for 127.0.0.1/localhost, verify-full otherwise)
DATABASE_SSL=""
# PEM of the database CA, only for a REMOTE database over TLS. Not needed on Hostinger.
DATABASE_SSL_CA=""
# Connections per app process. Shared hosting limits connections per database user.
DATABASE_POOL_MAX="5"
# "true" serves a 503 page to visitors without touching the database (admin and cron keep working).
MAINTENANCE_MODE=""
MAINTENANCE_RETRY_AFTER="600"

# ============================================================================
# 4) OPTIONAL FALLBACKS — prefer Admin → Settings. A value saved in the dashboard
#    always wins; these are only used while nothing has been saved there (handy
#    for local development and for keeping an existing deployment working).
# ============================================================================

# Scheduled jobs (Settings → Scheduled tasks). At least 32 characters.
CRON_SECRET=""
JOBS_TICK_BUDGET_MS="25000"
# Email (Settings → Email). "smtp" enables sending; "log" only records messages.
EMAIL_TRANSPORT="log"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Webcenta <noreply@webcenta.com>"
# Storage (Settings → Storage). Production: an ABSOLUTE folder outside the app directory.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_BASE_URL=""
# Sign-in providers (Settings → Google / Apple / GitHub OAuth; the pages show the callback URLs).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# Contents of the AuthKey_XXXXXXXXXX.p8 file (newlines as \n). Webcenta signs the client secret itself.
APPLE_PRIVATE_KEY=""
# Legacy alternative to the key: a pre-generated client-secret JWT (expires within 6 months).
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Security (Settings → Security & authentication).
ADMIN_IP_ALLOWLIST=""
GEO_COUNTRY_HEADER="cf-ipcountry"
GEO_UNKNOWN_POLICY="deny"
TRUSTED_PROXY_HOPS="1"
# Threat intelligence (Settings → URL scanning).
GOOGLE_WEB_RISK_API_KEY=""
URLHAUS_AUTH_KEY=""
VIRUSTOTAL_API_KEY=""
# Site banner (Settings → General).
SITE_BANNER=""

# ============================================================================
# 5) DEVELOPMENT / TEST ONLY — never set in production
# ============================================================================
# Load fictional sample listings with `npm run db:seed -- --fixtures`.
ALLOW_DEV_FIXTURES=""
# Lets the scanner reach *.localhost fixture sites (ignored unless PUBLIC_ORIGIN is localhost).
SCANNER_ALLOW_PRIVATE_FOR_TESTS=""
# Enables /e2e-test/* routes that throw deliberately (same localhost guard).
ENABLE_TEST_ERROR_ROUTES=""
