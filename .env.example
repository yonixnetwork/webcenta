# Copy to .env for local development. NEVER commit .env or real credentials.
# Production values are set in Hostinger hPanel (see docs/DEPLOYMENT.md).

NODE_ENV=development

# --- Database (PostgreSQL 15+; production: Supabase) ---
# Runtime connection. Supabase: transaction pooler, port 6543.
DATABASE_URL="postgresql://webcenter:CHANGE_ME@localhost:5432/webcenter_dev"
# Migrations/seeding (Prisma CLI). Supabase: session pooler, port 5432. Optional locally.
DIRECT_URL=""
# disable | require | verify-full   (default: disable for localhost, verify-full otherwise)
DATABASE_SSL=""
# PEM of the database CA (Supabase: Database settings → SSL certificate). "\n" escapes allowed.
DATABASE_SSL_CA=""
DATABASE_POOL_MAX="5"

# --- Origins (no trailing slash) ---
PUBLIC_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://admin.localhost:3000"
DEVELOPER_ORIGIN="http://developers.localhost:3000"

# --- Request context ---
# Header with the visitor's ISO country (Cloudflare: cf-ipcountry). Best effort only.
GEO_COUNTRY_HEADER="cf-ipcountry"
# allow | deny — show geo-restricted listings when the country is unknown?
GEO_UNKNOWN_POLICY="deny"
# Number of reverse proxies in front of the app that append to X-Forwarded-For.
TRUSTED_PROXY_HOPS="1"

# --- Scheduled jobs (Hostinger Cron → POST /api/cron/tick) ---
# At least 32 characters: openssl rand -hex 32
CRON_SECRET=""
JOBS_TICK_BUDGET_MS="25000"

# --- Media (Phase 2: S3-compatible public bucket/CDN base URL) ---
MEDIA_PUBLIC_BASE_URL=""

# --- Optional banner text (e.g. on staging) ---
SITE_BANNER=""

# --- Dev fixtures: required to load fictional sample listings (never in production) ---
ALLOW_DEV_FIXTURES=""

# --- Later phases (unused yet) ---
USER_AUTH_SECRET=""
ADMIN_AUTH_SECRET=""
FIELD_ENCRYPTION_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="WebCenter <no-reply@webcenter.com>"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
GOOGLE_WEB_RISK_API_KEY=""
URLHAUS_AUTH_KEY=""
VIRUSTOTAL_API_KEY=""
SENTRY_DSN=""
