# Copy to .env for local development. NEVER commit .env or real credentials.
# Production values are set in Hostinger hPanel (see docs/DEPLOYMENT.md).

NODE_ENV=development

# --- Database (PostgreSQL 15+; production: Supabase) ---
# Runtime connection. Supabase: transaction pooler, port 6543.
DATABASE_URL="postgresql://webcenter:CHANGE_ME@localhost:5432/webcenter_dev"
# Migrations/seeding (Prisma CLI). Supabase: session pooler, port 5432. Optional locally.
DIRECT_URL=""
# disable | require | verify-full   (default: disable for localhost, verify-full otherwise)
DATABASE_SSL=""
# PEM of the database CA (Supabase: Database settings → SSL certificate). "\n" escapes allowed.
DATABASE_SSL_CA=""
DATABASE_POOL_MAX="5"

# --- Origins (no trailing slash) ---
PUBLIC_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://admin.localhost:3000"
DEVELOPER_ORIGIN="http://developers.localhost:3000"

# --- Request context ---
# Header with the visitor's ISO country (Cloudflare: cf-ipcountry). Best effort only.
GEO_COUNTRY_HEADER="cf-ipcountry"
# allow | deny — show geo-restricted listings when the country is unknown?
GEO_UNKNOWN_POLICY="deny"
# Number of reverse proxies in front of the app that append to X-Forwarded-For.
TRUSTED_PROXY_HOPS="1"

# --- Scheduled jobs (Hostinger Cron → POST /api/cron/tick) ---
# At least 32 characters: openssl rand -hex 32
CRON_SECRET=""
JOBS_TICK_BUDGET_MS="25000"

# --- Media (Phase 2: S3-compatible public bucket/CDN base URL) ---
MEDIA_PUBLIC_BASE_URL=""

# --- Optional banner text (e.g. on staging) ---
SITE_BANNER=""

# --- Dev fixtures: required to load fictional sample listings (never in production) ---
ALLOW_DEV_FIXTURES=""

# --- Authentication (required in production) ---
# openssl rand -base64 32  (each ≥ 32 characters)
USER_AUTH_SECRET=""
ADMIN_AUTH_SECRET=""
# 32-byte key, base64 (openssl rand -base64 32). Encrypts admin TOTP secrets. Never change after use.
FIELD_ENCRYPTION_KEY=""
# Optional: comma-separated IPs allowed to reach the admin host (exact match).
ADMIN_IP_ALLOWLIST=""

# --- OAuth providers (leave empty to hide the buttons) ---
# Google: OAuth client (Web). Redirect URI: {PUBLIC_ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple: Services ID as client id; client secret = signed JWT from your .p8 key (rotate ≤ 6 months).
# Return URL: {PUBLIC_ORIGIN}/api/auth/callback/apple  (requires Apple Developer Program)
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""

# --- Email: "log" records messages only (dev/tests/staging); "smtp" sends ---
EMAIL_TRANSPORT="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="WebCenter <no-reply@webcenter.com>"

# --- File storage: "local" (single server / dev) or "s3" (R2, B2, S3, Spaces) ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Threat intelligence (optional; without at least one, nothing is auto-approved) ---
GOOGLE_WEB_RISK_API_KEY=""
URLHAUS_AUTH_KEY=""
VIRUSTOTAL_API_KEY=""

# --- TEST ONLY: lets the scanner reach *.localhost fixture sites. Ignored unless
# PUBLIC_ORIGIN is http://localhost:… NEVER set in staging/production. ---
SCANNER_ALLOW_PRIVATE_FOR_TESTS=""

# --- Error monitoring (optional; not wired yet) ---
SENTRY_DSN=""
